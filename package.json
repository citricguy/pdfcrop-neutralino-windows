{
  "name": "pdfcrop-neutralino-windows",
  "version": "1.0.0",
  "description": "Neutralinojs portable Windows desktop app wrapping the pdfcrop WebAssembly PDF cropper",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "neu:update": "neu update",
    "neu:build": "neu build --release",
    "dist": "npm run build && neu update && neu build --release"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.2.0",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.3.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "pdfjs-dist": "^4.0.379"
  },
  "keywords": [
    "pdf",
    "crop",
    "wasm",
    "neutralinojs",
    "desktop",
    "windows",
    "portable"
  ],
  "license": "MIT OR Apache-2.0"
}
