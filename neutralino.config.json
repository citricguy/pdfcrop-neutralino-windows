{
  "applicationId": "io.github.pdfcrop.windows",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "documentRoot": "/resources/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "exportAuthInfo": true,
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "debug.*",
    "events.*",
    "computer.*"
  ],
  "globalVariables": {
    "appName": "pdfcrop"
  },
  "modes": {
    "window": {
      "title": "pdfcrop — PDF Cropping Tool",
      "width": 1400,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "maximize": false,
      "fullScreen": false,
      "alwaysOnTop": false,
      "enableInspector": false,
      "borderless": false,
      "hidden": false,
      "maximizable": true
    }
  },
  "cli": {
    "binaryVersion": "5.5.0",
    "clientVersion": "3.9.0",
    "binaryName": "pdfcrop",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "defaultMode": "window"
  }
}
